<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>

    <link rel="stylesheet" href="/main.css"> 
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
</head>
<body>
    
    <div class="input container p-5 m-5">
        <form action="/new" method="post">
            <p>Title</p>
            <input id="new-title" type="text" name="title">
            <p>Author:</p>
            <input id="new-author" type="text" name="author">
            <p>ISBN:</p>
            <input id="isbn" type="text" name="isbn">
            <p>Date Read:</p>
            <input id="date" type="date" name="date">
            <p>Ratings:</p>
            <input id="ratings" type="number" name="rating">
            <p>Summary:</p>
            <textarea class="content-input" name="summary"></textarea>
            <p>Review: </p>
            <textarea class="content-input" name="review"></textarea> 
            <button id="submit-button" type="submit">Add</button>
        </form>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
</body>
</html>