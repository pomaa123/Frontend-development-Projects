<%- include('partials/header.ejs') %>

<!-- main body code here -->
<div class="p-5 mb-4 bg-body-tertiary rounded-3"> 
    <div class="container-fluid py-5"> 
        <h1 class="display-5 fw-bold">Where Stories Come to Life.</h1> 
        <p class="col-md-8 fs-4">Start blogging today and discover stories from creators around the world.</p> 
        <a href="/create-post"><button class="btn btn-primary btn-lg" type="button">Create Blog Post</button> </div> </div></a>
<div class="container py-4">
    <% if (locals.content) { %>
     
    <div class="row align-items-md-stretch"> 
        <% for( let item of content) { %>
        
            <div class="col-md-6 mt-4"> 
                <div class="h-100 p-5 bg-body-tertiary border rounded-3"> 
                    <h2><%= item.title %></h2> 
                    <p><%= item.story %></p> 
                    <button class="btn btn-outline-secondary" type="button">Read more</button> 
                </div> 
            </div>

        <% } %>
        
    </div>
    <% } %>
</div>

<%- include('partials/footer.ejs') %>